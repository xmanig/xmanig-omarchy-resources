#!/usr/bin/env bash
set -u

# Emit tab-separated records consumed by Panel.qml:
#   cpu<TAB>total-percent<TAB>core0,core1,...
#   ram<TAB>used-percent<TAB>used-kib<TAB>total-kib
#   gpu<TAB>load-percent-or--<TAB>vram-used-bytes<TAB>vram-total-bytes<TAB>name

sample_cpu() {
  awk '/^cpu([0-9]+)? / { print $1, $2, $3, $4, $5, $6, $7, $8, $9 }' /proc/stat
}

before=$(sample_cpu)
sleep 0.20
after=$(sample_cpu)

awk '
  NR == FNR {
    before[$1] = $2 FS $3 FS $4 FS $5 FS $6 FS $7 FS $8 FS $9
    next
  }
  {
    split(before[$1], b, FS)
    before_total = 0
    after_total = 0
    for (i = 1; i <= 8; i++) {
      before_total += b[i]
      after_total += $(i + 1)
    }
    before_idle = b[4] + b[5]
    after_idle = $5 + $6
    total_delta = after_total - before_total
    active_delta = total_delta - (after_idle - before_idle)
    percent = total_delta > 0 ? 100 * active_delta / total_delta : 0
    rounded = sprintf("%.0f", percent)
    if ($1 == "cpu") total_load = rounded
    else {
      if (cores != "") cores = cores ","
      cores = cores rounded
    }
  }
  END { printf "cpu\t%s\t%s\n", total_load, cores }
' <(printf '%s\n' "$before") <(printf '%s\n' "$after")

read -r mem_total mem_available < <(
  awk '/^MemTotal:/{total=$2} /^MemAvailable:/{available=$2} END{print total, available}' /proc/meminfo
)
mem_used=$((mem_total - mem_available))
mem_percent=$(awk -v used="$mem_used" -v total="$mem_total" 'BEGIN { printf "%.0f", (total > 0 ? 100 * used / total : 0) }')
printf 'ram\t%s\t%s\t%s\n' "$mem_percent" "$mem_used" "$mem_total"

# NVIDIA exposes utilization and VRAM through nvidia-smi. Prefer it when
# available; otherwise use the kernel's amdgpu or i915 sysfs counters.
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia_line=$(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total,name \
    --format=csv,noheader,nounits 2>/dev/null | head -n 1)
  if [[ -n "$nvidia_line" ]]; then
    printf '%s\n' "$nvidia_line" | awk -F',' '{
      for (i = 1; i <= NF; i++) gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i)
      printf "gpu\t%s\t%s\t%s\t%s\n", $1, $2 * 1024 * 1024, $3 * 1024 * 1024, $4
    }'
    exit 0
  fi
fi

for busy in /sys/class/drm/card*/device/gpu_busy_percent /sys/class/drm/card*/device/gt_busy_percent; do
  [[ -r "$busy" ]] || continue
  device_dir=${busy%/*}
  load=$(cat "$busy" 2>/dev/null || printf '%s' '-')
  used=0
  total=0
  [[ -r "$device_dir/mem_info_vram_used" ]] && used=$(cat "$device_dir/mem_info_vram_used")
  [[ -r "$device_dir/mem_info_vram_total" ]] && total=$(cat "$device_dir/mem_info_vram_total")
  printf 'gpu\t%s\t%s\t%s\t%s\n' "$load" "$used" "$total" "GPU"
  exit 0
done

printf 'gpu\t-\t0\t0\tUnavailable\n'
